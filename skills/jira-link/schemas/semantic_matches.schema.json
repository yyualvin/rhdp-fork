{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Jira Matches",
  "description": "Claude semantic match output for Jira ticket linking",
  "type": "object",
  "required": ["matches"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "confidence"],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "ticket_key": {
            "type": ["string", "null"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "none"]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
